{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harrik",
  "main": ".open-next/worker.js",
  // Cloudflare's Workers Builds finishes with `npx wrangler deploy`, and wrangler
  // hands an OpenNext project straight to `opennextjs-cloudflare deploy` — a
  // `build` hook here is never reached. So `.open-next/` has to exist by the time
  // the deploy command runs, which is why `pnpm run build` (the CI build command)
  // is `opennextjs-cloudflare build` rather than a plain `next build`.
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PRIVATE_MINIMAL_MODE": "1",
    "NEXT_PUBLIC_SUPABASE_URL": "https://jcgnhttbkjlpgnekecor.supabase.co",
    "NEXT_PUBLIC_APP_TIMEZONE": "Asia/Qatar",
    "NEXT_PUBLIC_VAPID_PUBLIC_KEY": "BART6R8K4H5UgAnsX0pv2R_EOig_ysflTPNAx_9bYV28ebl9nMusM_TiRzXiyMvhbOto-zgteJ0uw89F4GjxkUc",
    "VAPID_SUBJECT": "mailto:security@harrik.qa"
  }
}
