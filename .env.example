NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
NEXT_PUBLIC_APP_TIMEZONE=Asia/Qatar

# ---------------------------------------------------------------------------
# Optional integrations — all safe no-ops when left empty.
# ---------------------------------------------------------------------------

# Web Push (VAPID) — required for lock-screen notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@harrik.qa

# Bot protection (Cloudflare Turnstile) — set BOTH together to enable.
# Wired into /register, /scan alert submission.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMS fallback for unreachable vehicle owners (twilio | unifonic)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=

# Transactional email (resend | sendgrid)
EMAIL_PROVIDER=
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@harrik.app

# Central error reporting (§11.8) — optional, console-only when unset.
# All payloads are PII-scrubbed before leaving the process.
SENTRY_DSN=
ERROR_WEBHOOK_URL=

# Platform governance
# Set to "false" to make organization onboarding invite-only.
ALLOW_SELF_SERVE_ONBOARDING=
# Shared secret for the escalation scheduler (POST /api/alerts/escalate)
CRON_SECRET=
# Default recipients for the scheduled e-mail report (POST /api/reports/email)
REPORT_EMAIL_TO=

# Non-production only: serve deterministic seed/permit fixtures
ENABLE_TEST_FIXTURES=