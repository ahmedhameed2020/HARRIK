# حَرِّك | HARRIK — Environment Variables
# Copy to .env.local and populate with your Supabase project credentials

# Supabase Public API (Accessible by browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Server-Only Secret (NEVER expose to browser code!)
# Used strictly for admin tasks, seed bootstrapping, and bulk imports
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Default Application Organization ID (Primary tenant)
NEXT_PUBLIC_DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001
